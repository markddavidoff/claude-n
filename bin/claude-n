#!/usr/bin/env bash
# claude-n: launch Claude Code under isolated per-account config directories.
set -euo pipefail

CLAUDE_N_VERSION="0.1.0"

usage() {
  cat <<EOF
claude-n ${CLAUDE_N_VERSION}: run Claude Code under isolated per-account config dirs.

Usage:
  claude-n <command> [args...]

Commands:
  install      Add the claude-n hook line to your zsh rc
  uninstall    Remove the claude-n hook line from your zsh rc
  init         Print shell integration (usage: claude-n init zsh)
  ls           List configured accounts and who is logged in
  rm           Remove an account (usage: claude-n rm <N> [--yes])
  which        Show the config dir for an account (usage: claude-n which <N>)

Options:
  -h, --help       Show this help and exit
  -v, --version    Show the version and exit
EOF
}

# Print the zsh snippet that maps claudeN / claude-N to isolated config dirs.
# The body is zsh, so it lives in a quoted heredoc (no expansion, not parsed
# as bash).
init_zsh() {
  cat <<'ZSH_SNIPPET'
# claude-n (zsh)
if [[ -z ${__CLAUDE_N_INSTALLED:-} ]]; then
  if typeset -f command_not_found_handler >/dev/null; then
    eval "${$(typeset -f command_not_found_handler)/command_not_found_handler/__claude_n_prev_cnf}"
  fi
  typeset -g __CLAUDE_N_INSTALLED=1
fi
__claude_n_resolve() {
  emulate -L zsh
  [[ "$1" =~ '^claude-?([0-9]{1,15})$' ]] || return 1
  local n=$((10#${match[1]}))            # strip leading zeros
  (( n == 0 )) && return 1               # claude0 -> passthrough
  (( n == 1 )) && { print -r -- default; return 0; }
  print -r -- "${CLAUDE_N_HOME:-$HOME/.claude-n}/$n"; return 0
}
command_not_found_handler() {
  emulate -L zsh
  local target
  if target=$(__claude_n_resolve "$1"); then
    if (( ! $+commands[claude] )); then
      print -u2 -- "claude-n: 'claude' not found on PATH"; return 127
    fi
    if [[ "$target" != default ]]; then
      mkdir -p "$target" || return 1
      export CLAUDE_CONFIG_DIR="$target"
    fi
    exec command claude "${@:2}"
  fi
  if typeset -f __claude_n_prev_cnf >/dev/null; then __claude_n_prev_cnf "$@"; return $?; fi
  print -u2 -- "zsh: command not found: $1"; return 127
}
ZSH_SNIPPET
}

cmd_init() {
  case "${1:-}" in
    zsh)
      init_zsh
      ;;
    "")
      echo "claude-n init: missing shell argument (supported: zsh)" >&2
      return 2
      ;;
    *)
      echo "claude-n init: unsupported shell: $1 (only zsh is supported)" >&2
      return 2
      ;;
  esac
}

# The one line install/uninstall manage in the user's zsh rc. Single quotes keep
# $(...) literal; it is matched and written as a fixed string, never a regex.
# shellcheck disable=SC2016  # literal $(...) is intended
RC_LINE='eval "$(claude-n init zsh)"'

# rc file to edit: $CLAUDE_N_RC if set, else ${ZDOTDIR:-$HOME}/.zshrc.
rc_path() {
  printf '%s\n' "${CLAUDE_N_RC:-${ZDOTDIR:-$HOME}/.zshrc}"
}

cmd_install() {
  local rc
  rc=$(rc_path)
  if [[ -f "$rc" ]] && grep -qxF -- "$RC_LINE" "$rc"; then
    echo "claude-n: already installed in $rc"
    return 0
  fi
  touch "$rc"
  # If the file's last line lacks a newline, add one so the hook gets its own line.
  if [[ -s "$rc" && -n "$(tail -c 1 "$rc")" ]]; then
    printf '\n' >> "$rc"
  fi
  printf '%s\n' "$RC_LINE" >> "$rc"
  echo "claude-n: added hook line to $rc"
  echo "Restart your shell (or run 'exec zsh'), then run 'hash -r' to refresh the command cache."
}

cmd_uninstall() {
  local rc tmp
  rc=$(rc_path)
  if [[ ! -f "$rc" ]] || ! grep -qxF -- "$RC_LINE" "$rc"; then
    echo "claude-n: no hook line found in $rc"
    return 0
  fi
  tmp=$(mktemp)
  # grep -v exits 1 when nothing is left to print; that is fine here.
  grep -vxF -- "$RC_LINE" "$rc" > "$tmp" || true
  # Write through the original path (not mv) to keep its mode and any symlink.
  # Clean the temp file on both outcomes; set -e would otherwise leak it.
  if ! cat "$tmp" > "$rc"; then
    rm -f "$tmp"
    echo "claude-n: could not write $rc" >&2
    return 1
  fi
  rm -f "$tmp"
  echo "claude-n: removed hook line from $rc"
}

# Account home: same resolution as the zsh handler in init_zsh.
account_home() {
  printf '%s\n' "${CLAUDE_N_HOME:-$HOME/.claude-n}"
}

# Validate an account number and print it normalized (leading zeros stripped,
# exactly like the handler's $((10#n))). Rejects non-numeric input and 0.
normalize_account() {
  local cmd=$1 raw=${2:-}
  if [[ ! "$raw" =~ ^[0-9]{1,15}$ ]]; then
    echo "claude-n $cmd: account must be a number of 1-15 digits (got '${raw}')" >&2
    return 2
  fi
  local n=$((10#$raw))
  if (( n == 0 )); then
    echo "claude-n $cmd: account must be 1 or greater (got '${raw}')" >&2
    return 2
  fi
  printf '%s\n' "$n"
}

cmd_which() {
  if [[ $# -ne 1 ]]; then
    echo "usage: claude-n which <N>" >&2
    return 2
  fi
  local n
  n=$(normalize_account which "$1") || return $?
  if (( n < 2 )); then
    echo "account 1 is the default Claude config (no managed dir; uses your normal Claude config location)"
    return 0
  fi
  printf '%s/%s\n' "$(account_home)" "$n"
}

# Best-effort email from <dir>/.claude.json at oauthAccount.emailAddress,
# without jq. Newlines are flattened so a pretty-printed file works; the
# oauthAccount object is flat, so its first closing brace ends it. Prints
# nothing when the file or the email is absent.
account_email() {
  local file="$1/.claude.json" block
  [[ -f "$file" ]] || return 0
  block=$({ tr -d '\n' < "$file"; } 2>/dev/null \
    | grep -o '"oauthAccount"[[:space:]]*:[[:space:]]*{[^}]*}' | head -n 1 || true)
  [[ -n "$block" ]] || return 0
  printf '%s\n' "$block" \
    | grep -o '"emailAddress"[[:space:]]*:[[:space:]]*"[^"]*"' | head -n 1 \
    | sed 's/.*:[[:space:]]*"\(.*\)"$/\1/' || true
}

cmd_ls() {
  local home entry name email found=0
  home=$(account_home)
  if [[ -d "$home" ]]; then
    # Numeric-only names are accounts; .trash-* backups and stray dirs are skipped.
    while IFS= read -r name; do
      entry="$home/$name"
      email=$(account_email "$entry")
      printf '%-4s %s\n' "$name" "${email:-not logged in}"
      found=1
    done < <(
      for entry in "$home"/*/; do
        [[ -d "$entry" ]] || continue
        name=$(basename "$entry")
        [[ "$name" =~ ^[0-9]+$ ]] && printf '%s\n' "$name"
      done | sort -n
    )
  fi
  if (( found == 0 )); then
    echo "no accounts under $home"
  fi
  return 0
}

cmd_rm() {
  local assume_yes=0 arg raw="" n home dir stamp trash answer
  for arg in "$@"; do
    case "$arg" in
      -y|--yes) assume_yes=1 ;;
      -*)
        echo "claude-n rm: unknown option: $arg" >&2
        return 2
        ;;
      *)
        if [[ -n "$raw" ]]; then
          echo "usage: claude-n rm <N> [--yes]" >&2
          return 2
        fi
        raw=$arg
        ;;
    esac
  done
  if [[ -z "$raw" ]]; then
    echo "usage: claude-n rm <N> [--yes]" >&2
    return 2
  fi
  n=$(normalize_account rm "$raw") || return $?
  if (( n < 2 )); then
    echo "claude-n rm: refusing to remove account 1 (the default has no managed dir)" >&2
    return 1
  fi
  home=$(account_home)
  dir="$home/$n"
  if [[ ! -d "$dir" ]]; then
    echo "claude-n rm: account $n not found at $dir" >&2
    return 1
  fi
  if (( assume_yes == 0 )); then
    printf "Remove account %s (%s)? A backup is kept in %s/.trash-*. [y/N] " "$n" "$dir" "$home" >&2
    answer=""
    read -r answer || true
    case "$answer" in
      y|Y|yes|YES|Yes) ;;
      *)
        echo "claude-n rm: aborted" >&2
        return 1
        ;;
    esac
  fi
  stamp=$(date +%Y%m%d%H%M%S)
  trash="$home/.trash-$n-$stamp"
  # Never overwrite an existing backup from the same second.
  while [[ -e "$trash" ]]; do
    trash="$trash-$$"
  done
  mv -- "$dir" "$trash"
  echo "claude-n: removed account $n; backup kept at $trash"
}

main() {
  if [[ $# -eq 0 ]]; then
    usage
    return 0
  fi

  case "$1" in
    -h|--help)
      usage
      ;;
    -v|--version)
      echo "claude-n ${CLAUDE_N_VERSION}"
      ;;
    init)
      shift
      cmd_init "$@"
      ;;
    install)
      cmd_install
      ;;
    uninstall)
      cmd_uninstall
      ;;
    ls)
      cmd_ls
      ;;
    rm)
      shift
      cmd_rm "$@"
      ;;
    which)
      shift
      cmd_which "$@"
      ;;
    *)
      echo "claude-n: unknown command: $1" >&2
      echo "Run 'claude-n --help' for usage." >&2
      return 2
      ;;
  esac
}

main "$@"
